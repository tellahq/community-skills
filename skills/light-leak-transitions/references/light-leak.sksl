// Light leak for Tella Motion: three noise-warped light blobs sweep across the frame,
// with a wash of light at progress 0.5, where the cut goes. Use on a full-frame black
// fill shape with blendMode "screen". Output depends only on progress.
uniform shader image;
uniform float2 resolution;
uniform float progress;   // 0..1 across the leak; key it linear 0 -> 1
uniform float seed;       // any number; changes the shape
uniform float angle;      // travel direction in degrees: 0 left to right, -15 rising to the right, 200 right to left
uniform float strength;   // blob brightness, about 1.0
uniform float coverage;   // how much the whole frame washes at the cut: 0.55 on bright footage, 0.75 on dark
uniform float grain;      // film grain in the light, 0.04..0.05
uniform half4 deep;       // edge colour, linear 0..1 RGBA
uniform half4 mid;        // body colour
uniform half4 hot;        // core colour

float hash(float2 q) {
  float3 p3 = fract(float3(q.x, q.y, q.x) * 0.1031 + seed * 0.0173);
  p3 += dot(p3, p3.yzx + 33.33);
  return fract((p3.x + p3.y) * p3.z);
}
float vnoise(float2 q) {
  float2 i = floor(q); float2 f = fract(q); f = f * f * (3.0 - 2.0 * f);
  float a = hash(i); float b = hash(i + float2(1.0, 0.0));
  float c = hash(i + float2(0.0, 1.0)); float d = hash(i + float2(1.0, 1.0));
  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}
float fbm(float2 q) {
  float s = 0.0; float amp = 0.5;
  for (int k = 0; k < 4; k++) { s += amp * vnoise(q); q = q * 2.03 + float2(1.7, 9.2); amp *= 0.5; }
  return s;
}
float blob(float2 q, float2 dir, float2 nrm, float t, float lead, float perp, float r, float speed, float w) {
  float trav = (-1.9 + 3.8 * t) * speed + lead;
  float2 c = dir * trav + nrm * perp;
  float rr = r * (0.8 + 0.6 * sin(3.14159 * t));
  float2 dd = q - c;
  float a = dot(dd, dir) / rr;
  float b = dot(dd, nrm) / (rr * 1.8);
  float d = sqrt(a * a + b * b) + (w - 0.5) * 1.1;
  return exp(-d * d * 1.6);
}

half4 main(float2 p) {
  float t = clamp(progress, 0.0, 1.0);
  float2 q = (p - 0.5 * resolution) / resolution.y;
  float an = radians(angle);
  float2 dir = float2(cos(an), sin(an));
  float2 nrm = float2(-dir.y, dir.x);
  float w = fbm(q * 1.3 + float2(t * 0.6 + seed, -t * 0.4));
  float w2 = fbm(q * 3.0 + float2(5.0 - t * 0.9, 2.0 + t * 0.5));
  float I = blob(q, dir, nrm, t, 0.0, -0.25, 0.55, 1.0, w)
          + 0.8 * blob(q, dir, nrm, t, -0.45, 0.35, 0.45, 0.85, w)
          + 0.7 * blob(q, dir, nrm, t, 0.35, 0.05, 0.30, 1.2, w);
  I *= 0.7 + 0.6 * w2;
  float env = smoothstep(0.0, 0.35, t) * (1.0 - smoothstep(0.65, 1.0, t));
  float pk = (t - 0.5) / 0.09;
  float peak = exp(-pk * pk);
  I = I * env * strength + peak * coverage * (0.65 + 0.5 * w);
  I *= 1.0 + grain * (hash(floor(p / 2.0) + floor(t * 40.0) * float2(37.0, 17.0)) - 0.5) * 2.0;
  half3 col = mix(deep.rgb, mid.rgb, half(smoothstep(0.0, 0.6, I)));
  col = mix(col, hot.rgb, half(smoothstep(0.95, 1.9, I)));
  half e = half(clamp(I, 0.0, 1.0));
  return half4(col * e, 1.0);
}
